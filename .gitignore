# ============================================================
#  learn-LLM  .gitignore
#  说明：本仓库只收录「代码 / 配置 / 文档 / 小型示例数据」。
#        所有 >= 10MB 的数据集与模型权重已按体积精确排除，
#        清单见文件末尾「按体积排除的文件」段落，
#        数据资产整体清单见 excluded_large_files.txt。
# ============================================================

# ---------- Python 缓存 / 字节码 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/

# ---------- 虚拟环境 / 依赖 ----------
.venv/
venv/
env/
ENV/
node_modules/

# ---------- 测试 / 类型检查 / Notebook 缓存 ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---------- IDE ----------
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------- 敏感信息（切勿提交）----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- 训练产物目录（保留目录结构，内容按体积排除）----------
*.log
logs/
wandb/
runs/
outputs/

# ============================================================
#  按体积排除的文件（>= 10MB，共 196 个 / 108.74 GB）
#  如需上传其中某个文件，删除对应行即可。
# ============================================================


